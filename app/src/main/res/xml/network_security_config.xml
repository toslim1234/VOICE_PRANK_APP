<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. A self-hosted backend must use https as well. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
